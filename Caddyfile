{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	route {
		encode gzip

		# Health is checked inside the docker network. Do not publish actuator.
		@actuator path /actuator/*
		respond @actuator 404

		# flush_interval -1 keeps SockJS / STOMP websockets unbuffered.
		# X-Forwarded-For and X-Forwarded-Proto are set by Caddy by default.
		reverse_proxy app:8080 {
			flush_interval -1
		}
	}
}

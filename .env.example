# cp .env.example .env
# 값을 모두 채운 뒤 사용한다. .env 는 git에 올리지 않는다.
# 비밀번호에 $ 문자를 넣지 않는다. docker compose가 변수를 치환한다.

# --- 공개 주소 ---
DOMAIN=jamye-backend.o-r.kr
ACME_EMAIL=you@example.com
FRONT_URL=https://jamye.p-e.kr
IMAGE_URL=https://d23eha8a4ssn72.cloudfront.net
# 쉼표로 구분. 끝 슬래시는 넣어도 서버가 제거한다.
# file:// 와 https://localhost 는 Cordova 앱용이다.
CORS_ALLOWED_ORIGINS=https://jamye.p-e.kr,file://,file://*,https://localhost,http://localhost:8080,http://localhost:8081,http://jamye-frontend.s3-website.ap-northeast-2.amazonaws.com,https://d39kn92x79hg54.cloudfront.net

# --- Spring ---
SPRING_PROFILES_ACTIVE=prod
# 기존 RDS 덤프를 넣을 때는 none. 빈 DB에 스키마를 만들 때만 update.
JPA_DDL_AUTO=none

# --- MySQL (호스트 포트로 열지 않음) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jamye_prod
MYSQL_USER=jamye
MYSQL_PASSWORD=change-me-db
DB_URL=jdbc:mysql://mysql:3306/jamye_prod?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=jamye
DB_PASSWORD=change-me-db

# --- Redis (호스트 포트로 열지 않음) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# --- JWT. Base64, 32바이트 이상. 생성: openssl rand -base64 32 ---
# 이 값을 바꾸면 기존 로그인 토큰이 모두 무효가 된다.
JWT_SECRET_KEY=REPLACE_WITH_BASE64

# --- Discord ---
DISCORD_CLIENT_ID=replace-me
DISCORD_SECRET_KEY=replace-me
BOT_TOKEN=replace-me
DISCORD_REDIRECT=https://jamye.p-e.kr/oauth/redirect

# --- Kakao ---
KAKAO_CLIENT_ID=replace-me
KAKAO_REDIRECT=https://jamye.p-e.kr/oauth/kakao

# --- Google 로그인 ---
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# --- AWS S3. 버킷과 CloudFront는 기존 것을 그대로 쓴다. ---
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=jamye-image
AWS_REGION=ap-northeast-2

# --- Firebase Admin (FCM). 서비스 계정 JSON을 secrets/에 두고 경로만 적는다. ---
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-adminsdk.json
FIREBASE_PROJECT_ID=replace-me

# --- Google Cloud Vision. 서비스 계정 JSON 경로. ---
GOOGLE_CREDENTIALS_FILE=./secrets/google-vision.json

# --- Gmail SMTP ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=replace-with-gmail-app-password

# --- Sentry. 비우면 전송하지 않는다. 작은 VM은 0.1 권장. ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- 선택. 메모리 큰 VM에서만 주석을 해제한다. ---
# JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=55.0 -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Seoul -Dfile.encoding=UTF-8
